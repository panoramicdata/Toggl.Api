<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Enable reflection-based JSON serialization for .NET 10 compatibility -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AssemblyName>Toggl.Api</AssemblyName>
    <RootNamespace>Toggl.Api</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Company>Panoramic Data Limited</Company>
    <Description>Toggl API</Description>
    <Copyright>Panoramic Data Limited 2021-2025</Copyright>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/panoramicdata/toggl.api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/toggl.api</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <Authors>Panoramic Data Limited</Authors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
			Security fix: sensitive HTTP headers are now redacted in diagnostic output.

			Previously AuthenticatedHttpClientHandler joined every request and response header, key and
			value, into its Debug level log message. The handler sets an Authorization header carrying the
			API token, base64 encoded, on every request, so a usable credential was written verbatim and was
			trivially recoverable by decoding it. Any consumer running at Debug retained usable credentials
			for the life of its log store, and a Toggl API token does not expire.

			Authorization, Proxy-Authorization, Cookie, Set-Cookie and common API key headers are now
			redacted, case-insensitively, on request and response, along with any vendor-prefixed variant
			whose name ends in "Authorization". The scheme and credential length are retained, so requests
			remain diagnosable. The log line format is otherwise unchanged.

			Consumers should upgrade, review existing Debug logs for previously captured tokens, and
			regenerate any token that appears in them.

			Breaking Change: Renamed all "Me" references to "CurrentUser".
			Note: Toggl have crippled their API, limiting even Premium users to 600 API calls per hour.
			Beyond that, you will receive HTTP 402 "Payment Required" response - this is an incorrect HTTP Status - it should be 429 "Too Many Requests".
			You can provide your feedback to Toggl here: https://community.toggl.com/
		</PackageReleaseNotes>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Title>Toggl.Api</Title>
    <PackageTags>Toggl Api Client</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Toggl.Api</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
    <WarningLevel>8</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
    <WarningLevel>8</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Toggl.Api.Test" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Refit" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>